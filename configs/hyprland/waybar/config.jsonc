{
  "layer": "top",
  "modules-left": ["custom/appmenu", "battery", "hyprland/workspaces", "mpris"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "network",
    "memory",
    "temperature",
    "pulseaudio",
    "bluetooth",
    "tray",
    "hyprland/language",
    "clock",
    "custom/theme-toggle"
  ],
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "{id}",
    "format-icons": {
      "urgent": "",
      "focused": "",
      "active": "",
      "empty": "",
      "default": ""
    },
    "on-click": "activate",
    "disable-scroll": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 80,
    "separate-outputs": true
  },
  "temperature": {
    "thermal-zone": 2,
    "hwmon-path": ["/sys/class/hwmon/hwmon4/temp1_input"],
    "critical-threshold": 80,
    "format-critical": "{temperatureC}°C ",
    "format": "{temperatureC}°C ",
    "on-click": "foot --title btop -e btop"
  },
  "custom/theme-toggle": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/toggle-gtk-mode.sh"
  },
  "custom/appmenu": {
    "format": "󰣇",
    "tooltip-format": "Applications",
    "on-click": "~/.config/hypr/scripts/appLauncher.sh",
    "tooltip": true
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d, %Y}  "
  },
  "memory": {
    "format": "{:>3}% ",
    "on-click": "foot --title btop -e btop"
  },
  "network": {
    "format-disabled": " Disabled",
    "format-wifi": "{bandwidthDownBits:>} ",
    "tooltip-format-wifi": "{essid}",
    "format-ethernet": "{bandwidthDownBits:>} ",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "format-disconnected": " No network",
    "on-click": "foot --title nmtui -e nmtui",
    "interval": 2
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "Muted 󰸈",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "foot --title pulsemixer -e pulsemixer",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "tooltip-format": "{desc} • {volume}%"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{icon} {time}",
    "format-full": "{capacity}% ",
    "format-icons": ["", "", ""],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "mpris": {
    "player": "playerctld",
    "format": "{player_icon} {artist} - {title}",
    "player-icons": {
      "spotify": "",
      "firefox": "󰈹",
      "telegram-desktop": "",
      "default": "🎵"
    },
    "tooltip-format": "{player}: {status}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctld shift",
    "on-scroll-down": "playerctld unshift",
    "max-length": 40,
    "hide-on-empty": true
  },
  "hyprland/language": {
    "format": "{short}",
    "format-en": "US",
    "format-ru": "RU"
  },
  "bluetooth": {
    "controller": "controller1",
    "format": "󰂯 {status}",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "foot --title bluetuith -e bluetuith"
  }
}
