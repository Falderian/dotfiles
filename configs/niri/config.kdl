// ============================================================
// ~/.config/niri/config.kdl — fresh start, matching Hyprland muscle
// ============================================================
// Run `niri msg outputs` to find your monitor names
// Run `niri msg keyboard-layouts` to list available xkb layouts

// ============================================================
// ENVIRONMENT
// ============================================================
environment {
    XDG_CURRENT_DESKTOP  "niri"
    XDG_SESSION_TYPE     "wayland"
    XDG_SESSION_DESKTOP  "niri"

    // Qt
    QT_QPA_PLATFORM                     "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

    // GTK
    GDK_SCALE "1"

    // Firefox / Electron
    MOZ_ENABLE_WAYLAND          "1"
    OZONE_PLATFORM_HINT           "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    // Xcursor
    XCURSOR_SIZE  "24"
    XCURSOR_THEME "breeze_cursors"

    // Misc
    APPIMAGELAUNCHER_DISABLE "1"
}

// ============================================================
// INPUT
// ============================================================
input {
    keyboard {
        xkb {
            layout  "us,ru"
            options "grp:win_space_toggle,ctrl:nocaps"
        }
        numlock
    }

    touchpad {
        tap
    }

    // mouse {
    //     natural-scroll
    // }

    // Uncomment to auto-focus windows on mouse hover:
    // focus-follows-mouse max-scroll-amount="0%"
}

// ============================================================
// OUTPUTS  —  run `niri msg outputs` and fill in
// ============================================================
// output "eDP-1" {
//     mode "1920x1080@60"
//     // variable-refresh-rate  // uncomment for VRR
// }

// ============================================================
// LAYOUT
// ============================================================
layout {
    background-color "transparent"
    gaps 10

    center-focused-column "never"

    border {
        width 1
    }

    focus-ring {
        width 1
    }

    shadow {
        softness 30
        spread   5
        offset   x=0 y=5
    }

    default-column-width { proportion 1.0; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    struts {}
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ============================================================
// ANIMATIONS
// ============================================================
animations {
    // workspace-switch is spring-only in niri; set near-instant
    // for a fade-like feel, we keep window open/close doing the work
    
    workspace-switch {
        duration-ms 200
        curve "linear"
    }
    horizontal-view-movement {
        duration-ms 200
        curve "linear"
    }
    window-movement {
        spring damping-ratio=0.85 stiffness=450 epsilon=0.001
    }
    window-resize {
        spring damping-ratio=0.9 stiffness=500 epsilon=0.001
    }
    window-open {
        duration-ms 160
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }
    screenshot-ui-open {
        duration-ms 180
        curve "ease-out-cubic"
    }
}

// ============================================================
// BINDS  —  Mod = Super (Windows key)
// ============================================================
binds {
    // ── Terminal & Apps ──────────────────────────────────────
    Mod+Return { spawn "ghostty"; }
    Mod+E      { spawn "ghostty" "-e" "yazi"; }     // file manager
    Mod+B      { spawn "floorp"; }               // browser

    // ── Hotkey Overlay ───────────────────────────────────────
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── Window Management ────────────────────────────────────
    Mod+Q          { close-window; }
    Mod+Ctrl+Space { toggle-window-floating; }
    Mod+F          { fullscreen-window; }
    Mod+Shift+F    { maximize-column; }
    Mod+P          { toggle-column-tabbed-display; }

    // ── Noctalia Panel Toggles ──────────────────────────────
    Mod+R { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+W { toggle-overview; }
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "notification"; }
    Mod+M { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    // ── Focus (arrows + hjkl) ────────────────────────────────
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-workspace-up; }
    Mod+J     { focus-workspace-down; }

    // ── Move Windows ─────────────────────────────────────────
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // ── Resize Column / Window Height ────────────────────────
    Mod+Minus        { set-column-width "-5%"; }
    Mod+Equal        { set-column-width "+5%"; }
    Mod+Shift+Minus  { set-window-height "-5%"; }
    Mod+Shift+Equal  { set-window-height "+5%"; }
    Mod+Shift+R      { switch-preset-column-width; }
    Mod+Ctrl+R       { reset-window-height; }
    Mod+Ctrl+F       { expand-column-to-available-width; }

    // ── Column Tools ─────────────────────────────────────────
    Mod+C            { center-column; }
    Mod+Ctrl+C       { center-visible-columns; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // ── Workspaces 1–10 ──────────────────────────────────────
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // ── Workspace Navigation ─────────────────────────────────
    Mod+Tab                   { focus-workspace-down; }
    Mod+U                     { focus-workspace-down; }
    Mod+I                     { focus-workspace-up; }
    Mod+Page_Down             { focus-workspace-down; }
    Mod+Page_Up               { focus-workspace-up; }
    Mod+Ctrl+U                { move-column-to-workspace-down; }
    Mod+Ctrl+I                { move-column-to-workspace-up; }
    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+U               { move-workspace-down; }
    Mod+Shift+I               { move-workspace-up; }
    Mod+Ctrl+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }

    // ── Monitor Navigation ───────────────────────────────────
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }

    // ── Screenshots ────────────────────────────────────────────
    Print          { screenshot; }
    Ctrl+Print     { screenshot-screen; }
    Alt+Print      { screenshot-window; }
    Mod+F12        { screenshot; }
    Mod+Ctrl+F12   { screenshot-screen; }
    Mod+Shift+F12  { screenshot-window; }
    Mod+S          { screenshot; }              // 75% friendly
    Mod+Shift+S    { screenshot-window; }
    Mod+Ctrl+S     { screenshot-screen; }

    // ── Media ────────────────────────────────────────────────
    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioPause { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioStop  { spawn "playerctl" "stop"; }

    Mod+KP_Left  { spawn "playerctl" "previous"; }
    Mod+KP_Right { spawn "playerctl" "next"; }
    Mod+KP_Begin { spawn "playerctl" "play-pause"; } 
    Mod+KP_Up    { spawn "playerctl" "position" "10+"; }
 
    Mod+KP_4     { spawn "playerctl" "previous"; }
    Mod+KP_6     { spawn "playerctl" "next"; }
    Mod+KP_5     { spawn "playerctl" "play-pause"; } 
    Mod+KP_8     { spawn "playerctl" "position" "10+"; }

    // ── Volume ───────────────────────────────────────────────
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // ── System ───────────────────────────────────────────────
    Mod+Ctrl+L   { spawn "systemctl" "suspend"; }

    Mod+Escape        { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P       { power-off-monitors; }
    Mod+Shift+E       { quit; }
    Ctrl+Alt+Delete   { quit skip-confirmation=true; }
}

// ============================================================
// WINDOW RULES
// ============================================================
// Float these
window-rule {
    match app-id="nm-connection-editor"
    match app-id="blueman-manager"
    match app-id="gnome-calculator"
    match app-id="galculator"
    match app-id="xdg-desktop-portal"
    match app-id="xdg-desktop-portal-gnome"
    match app-id="xdg-desktop-portal-gtk"
    match app-id="org.gnome.Nautilus"
    open-floating true
}

// Picture-in-Picture / floating popups
window-rule {
    match app-id="firefox" title="^Picture-in-Picture$"
    match app-id="floorp" title="^Picture-in-Picture$"
    match app-id="helium" title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

// Terminals / browsers — don't draw border behind them
window-rule {
    match app-id="foot"
    match app-id="Alacritty"
    match app-id="kitty"
    match app-id="wezterm"
    match app-id="com.mitchellh.ghostty"
    match app-id="zen"
    match app-id="firefox"
    match app-id="floorp"
    match app-id="helium"
    draw-border-with-background false
}

// Steam notification toasts
window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// ============================================================
// AUTOSTART
// ============================================================
spawn-at-startup "noctalia"
spawn-at-startup "telegram-desktop" "-startintray"

include "noctalia.kdl"
